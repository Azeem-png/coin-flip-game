{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coin-flip-game",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		"NODE_ENV": "production",
		"JWT_EXPIRES_IN": "7d"
	},
	"containers": [
		{
			"class_name": "CoinFlipGame",
			"image": "./Dockerfile",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_CONTAINER",
				"class_name": "CoinFlipGame"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CoinFlipGame"]
		}
	]
}
